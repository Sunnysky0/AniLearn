# Local PostgreSQL. Use a random hexadecimal password before the first start.
POSTGRES_USER=anilearn
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# Optional image generation gateway for gpt-image-2.5-sunburst.
# Keep its key local; this credential is separate from tutor model settings.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
