{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "math:test": "tsx --test src/lib/math-markdown.test.ts src/components/Markdown.test.tsx",
    "free:test": "node --import tsx --test src/lib/server/free-input.test.ts src/lib/server/free-prompts.test.ts src/lib/server/free-protocol.test.ts src/lib/server/llm.test.ts",
    "reading:test": "node --import tsx --test src/lib/server/reading-learning.test.ts",
    "books:test": "node --import tsx --test src/lib/server/book-import.test.ts src/lib/server/book-learning.test.ts src/lib/server/book-prompts.test.ts src/lib/server/book-reliability.test.ts src/lib/reader/anchors.test.ts src/lib/reader/reader-layout.test.ts",
    "llm:test": "node --import tsx --test src/lib/server/llm.test.ts",
    "free:audit": "node output/audit/free-mode-api.mjs",
    "google-docs:test": "node --import tsx --test src/lib/google-docs.test.ts",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:status": "docker compose --env-file .env.local ps",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "launcher": "node scripts/launcher/bootstrap.cjs",
    "launcher:test": "tsx --test scripts/launcher/*.test.ts scripts/launcher/*.test.tsx"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@next/env": "16.2.6",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.2",
    "ink": "^6.8.0",
    "katex": "0.16.47",
    "lucide-react": "^1.52.0",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "16.2.6",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15",
    "undici": "^6.29.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "ink-testing-library": "^4.0.0",
    "postcss": "8.5.8",
    "string-width": "^8.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
